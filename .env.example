# Copy to .env (gitignored) and fill in real values.
# Host-side port bindings (all 127.0.0.1-only); override if the default is taken.
# RABBITMQ_PORT=5672
# RABBITMQ_MGMT_PORT=15672
# POSTGRES_PORT=5432

RABBITMQ_USER=airadar
RABBITMQ_PASSWORD=change-me
POSTGRES_DB=airadar
POSTGRES_USER=airadar
POSTGRES_PASSWORD=change-me

# LLM (digester) — provider behind LlmClient; "fake" runs the pipeline free
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# ⚠️ 2026-08-04 起 GEMINI_MODEL / LLM_*_USD_PER_MTOK **沒有生效路徑**：四層
# （DIGEST / SELECT / ESSAY / JUDGE）各自有 *_MODEL，digest 是最後一個分出去的。
# 這組值只剩「GeminiClient 未指定 model 時的建構預設」。要調哪一層就改那一層，
# 改這裡不會有任何效果——舊的 prod .env 把它設成 pro，現在那行是死的。
# GEMINI_MODEL=gemini-2.5-flash
# LLM_INPUT_USD_PER_MTOK=0.30
# LLM_OUTPUT_USD_PER_MTOK=2.50
# 取樣溫度。預設跟著模型世代走（2.5 用 0.2，gemini-3* 用 1.0，見 GeminiClient）；
# 只有要一次覆寫全部層級時才設這個。
# LLM_TEMPERATURE=1.0
DAILY_LLM_BUDGET_USD=0.50
# How many times a day the curator and the essayist may attempt their run. The
# tick loop retries a failed daily job every CURATOR_TICK_MINUTES, which is
# right for a transient failure and ruinous for a deterministic one — without
# this cap, a repeating failure re-buys the pro tier all night.
# DAILY_JOB_MAX_ATTEMPTS=3
# 逾時不計入上面那個上限：那一次呼叫從來沒拿到裁決，用當日額度去罰它，罰錯了
# 對象（2026-08-03 連三次逾時燒光當天，專欄整天沒出）。退還本身仍有上限，因為
# 逾時的那一次多半照樣付了錢（模型生成完了，只是我們沒等到，沒有回應就記不進
# 帳本）—— 無上限的退還等於繞過 DAILY_JOB_MAX_ATTEMPTS。
# DAILY_JOB_MAX_TIMEOUT_REFUNDS=2
# 單次 LLM 請求的逾時（秒）。這是便宜層級用的值：JUDGE 實測約 13 秒、DIGEST
# 約 12 秒。essay 那層另有自己的值，見 ESSAY_TIMEOUT_SECONDS。
# LLM_TIMEOUT_SECONDS=60
# Per-item digest tier. Own tier since 2026-08-04: it was inheriting
# GEMINI_MODEL (pro in prod) and spending 1,500 output tokens an item — mostly
# thinking — to summarise an article and score it, which was half the pipeline's
# daily cost. The significance score has no discrimination anyway (ADR-010
# amendment), so the deliberation was being bought for a judgement nothing
# downstream trusts. Set this back to pro only with a reason that survives
# looking at the ledger.
# DIGEST_MODEL=gemini-2.5-flash
# DIGEST_INPUT_USD_PER_MTOK=0.30
# DIGEST_OUTPUT_USD_PER_MTOK=2.50
# Digest at most this many (highest-value) items per UTC day; 0 = unlimited.
# The primary volume/cost cap — excess items re-park until the next day.
# Reality check 2026-08-04: intake is 6–14 items/day and nothing goes STALE, so
# this cap is not currently binding. Lowering it would drop the day's *later*
# arrivals (the queue is FIFO), not its weaker ones.
# DAILY_DIGEST_LIMIT=10
# News older than this many days is dropped to STALE before any spend (V5):
# the daily cap is FIFO, so without this a backlog starves fresh news and we'd
# comment on week-old items. Clock is published_at, else received_at. 0 = off.
# MATCH_MAX_AGE_DAYS=3
# Unacked messages held per consumer. Raising it does NOT let the daily cap or
# budget check be raced: the amqp-client dispatches one channel's deliveries
# sequentially, so a single digester checks the cap and digests one item at a
# time. Running two digesters WOULD race it — the cap has no DB-level guard.
# PREFETCH=8

# Resonance gate (matcher, ADR-010): news is embedded against the book library
# BEFORE any LLM spend. Nearest-book cosine distance beyond the threshold parks
# the item in NO_RESONANCE, terminal. Thresholds calibrated by the spike report
# (book-library-hub/docs/news-echo-spike-report.md).
# LIBRARY_PROVIDER=bridge            # "fake" runs the pipeline without the bridge
# LIBRARY_URL=http://library-bridge:7788
LIBRARY_SECRET=
# MATCH_NO_RESONANCE_DISTANCE=1.10
# MATCH_QUERY_CHARS=1500

# Daily essay (essayist): the strongest-resonance shortlist pick becomes the
# day's book-informed commentary. The model may decline (寧缺勿濫) — days
# without an essay are expected.
#
# 這一層是整條 pipeline 唯一「產品本身」的呼叫，一天只跑一次，所以它值得買最好
# 的：prod 跑 gemini-3.1-pro-preview（2.00/12.00）。兩件事要一起改——
#   1. 費率，否則帳本低估，而每日預算的斷路器是照帳本停的；
#   2. 預算，3.x 的 thinking token 按 output 計費且量很大（實測是答案的數倍），
#      一篇 essay 因此比 2.5-pro 貴好幾倍。
# preview 模型會改名下架，屆時整層會直接失效——靠 essay 停更指標發現。
# ESSAY_MODEL=gemini-3.1-pro-preview
# ESSAY_INPUT_USD_PER_MTOK=2.00
# ESSAY_OUTPUT_USD_PER_MTOK=12.00
# ESSAY_HOUR_UTC=22
# 這一層的逾時要自己給，不能吃 LLM_TIMEOUT_SECONDS 的 60 秒：essay 的 prompt
# 帶三章全文、跑在 3.x pro 上，2026-08-04 實測 57.3 秒——只差 2.7 秒就撞穿。
# 07-28 的 ~40 秒到 08-02 的 ~56 秒是一路爬上來的，而 07-31 / 08-02 / 08-03
# 三次真的撞穿了（連三次逾時＝當日重試用盡＝整天沒有專欄）。180 秒約是實測值
# 的三倍；這個工作一天只跑一次，等久一點沒有代價，等不到才有。
# ESSAY_TIMEOUT_SECONDS=180
# 給多少書證。2 章 × 6000 字是為 2.5-pro 的 context 訂的；essay 層跑 3.x 之後
# 這個數字才是深度的瓶頸，不是模型。ESSAY_CHAPTER_CHARS 同時被 essay prompt、
# 引文驗證與 publisher 的引文標記讀取——三邊必須是同一個值。
# ESSAY_MAX_CHAPTERS=3
# ESSAY_CHAPTER_CHARS=12000
# 引文逐字比對沒過時，帶著「哪幾句對不上」重寫一次（ADR-012）。觸發者是確定性
# 的字串比對、且只准一次，與被廢掉的 LLM critic 不是同一件事。
# ESSAY_REVISE_ON_BAD_QUOTES=true
# Relevance judge between curator and essayist: vector distance measures
# library density, not relatedness (ADR-010 amendment) — an LLM verdict gates
# each pick before any essay money is spent. Its own tier on purpose: a
# deployment may run GEMINI_MODEL on pro for digest quality, but a yes/no
# verdict must stay cheap. At most ESSAY_JUDGE_MAX_CANDIDATES verdicts/day.
# JUDGE_MODEL=gemini-2.5-flash
# JUDGE_INPUT_USD_PER_MTOK=0.30
# JUDGE_OUTPUT_USD_PER_MTOK=2.50
# ESSAY_JUDGE_MAX_CANDIDATES=3

# Selection (curator, ADR-009): once per UTC day after SELECT_HOUR_UTC the
# digester ranks the day's digests RELATIVE to each other with a stronger model
# and shortlists at most SHORTLIST_MAX_PER_DAY items for the book-informed
# daily commentary (M6). Costs land in the same daily budget above.
# SELECT_MODEL=gemini-2.5-pro
# SELECT_INPUT_USD_PER_MTOK=1.25
# SELECT_OUTPUT_USD_PER_MTOK=10.00
# SELECT_HOUR_UTC=21
# SELECT_MIN_SCORE=3
# How many picks the curator may shortlist per day. Lowered 3 → 2 on 2026-08-04:
# the essayist composes at most one a day and the TTL below expires the rest, so
# the third pick could never be used (29 picked in ten days, 8 became essays, 22
# of the 37 unused rows already past TTL). Two leaves a real fallback for the day
# the judge rejects the first. Raising it costs nothing and buys nothing — SELECT
# is a single call regardless.
# SHORTLIST_MAX_PER_DAY=2
# Uncomposed picks older than this drop out of the pool — news goes stale.
# SHORTLIST_TTL_DAYS=7
# CURATOR_TICK_MINUTES=5

# Publisher — plain output dir; the site-publisher sidecar owns the git push
# CONTENT_DIR=out/content
# PUBLISH_DIGEST=false                 # digest pages retired 2026-07-18; essays only.
#                                      # true resurrects daily/weekly markdown.

# site-publisher: push token for the bookshelf-echo-site repo (contents: write)
SITE_GIT_TOKEN=

# site-publisher 的健康指標寫到哪（node-exporter textfile collector 的目錄）。
# 預設值是 prod 的佈局：nplus-infra 與這個 repo 是 sibling。開發機上 nplus-infra
# 若不在隔壁，指到任一可寫目錄即可 —— 目錄不存在時腳本會靜默跳過，不影響同步。
# SITE_PUBLISH_TEXTFILE_DIR=../nplus-infra/data/node-exporter-textfile

# Producers (intervals in minutes; defaults: hn 60, blogs 240, guardian/news 180, others 1440)
# SOURCES=guardian                     # default; the essay wants deep journalism only.
#                                      # hn/arxiv/gh-trending/blogs/news still exist, re-enable here.
GUARDIAN_API_KEY=                      # REQUIRED for the guardian source (free: open-platform.theguardian.com)
# GUARDIAN_QUERIES=tag=news/series/the-long-read,section=commentisfree
# GUARDIAN_PAGE_SIZE=10

# BLOG_MAX_PER_FEED=20
# HN_QUERY=LLM
# HN_MIN_POINTS=30
# HN_INTERVAL_MINUTES=60
# ARXIV_CATEGORIES=cs.AI,cs.CL,cs.LG
# ARXIV_MAX_RESULTS=30
# GH_TRENDING_QUERY=topic:llm
# GH_TRENDING_WINDOW_DAYS=7
# BLOG_FEEDS=https://openai.com/news/rss.xml,https://huggingface.co/blog/feed.xml,https://simonwillison.net/atom/everything/
# REDDIT_SUBREDDITS=MachineLearning+LocalLLaMA
# REDDIT_LIMIT=25

# 各來源都吃 <SOURCE>_INTERVAL_MINUTES（名稱由 source id 大寫、- 換 _ 動態組成），
# 上面只示範了 HN_INTERVAL_MINUTES 一個。

# 抓取單篇內文的上限
# FETCH_TIMEOUT_SECONDS=10
# FETCH_MAX_CHARS=20000

# NEWS_MAX_PER_FEED=15

# Metrics (127.0.0.1-only; per-app defaults 9101-9105, 0 disables)
# METRICS_PORT=
# compose 會覆寫成 0.0.0.0 讓 Prometheus 抓得到；預設 127.0.0.1 是給 host 直跑用的
# METRICS_BIND=127.0.0.1
# SNAPSHOT_INTERVAL_MINUTES=60
# Grace before the first snapshot, so a deploy that restarts the whole stack does
# not record its siblings as consumer-less for a whole interval. 0 in tests.
# SNAPSHOT_SETTLE_SECONDS=45

# ===========================================
# compose 注入，host 直跑時才需要自己設
# ===========================================
# DATABASE_URL / RABBITMQ_HOST 由 docker-compose.yml 的 &app-env anchor 提供。
# 它們沒有程式碼預設值——缺了會在啟動時直接 error()，不是靜默退回。
# DATABASE_URL=jdbc:postgresql://localhost:5432/airadar
# RABBITMQ_HOST=localhost

# ===========================================
# 一次性 / 除錯用
# ===========================================
# 跑完一輪就結束，給 CI 與手動補跑用
# RUN_ONCE=false
# 閒置多久自動退出（0 = 不退出，長駐服務用這個）
# IDLE_EXIT_SECONDS=0
